{
  "name": "@karoy/dsh-gitlab-workbench",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "GitLab workbench: a left-sidebar entry and a global panel for several self-managed GitLab instances, focused on projects and CI pipelines.",
  "exports": {
    ".": "./dist/host/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.host.json",
    "build:client": "node build.mjs",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.host.json --noEmit",
    "test": "npm run build && node test/host-check.js 18080 && node test/client-check.cjs && node test/client-e2e.mjs 18080",
    "preview": "node test/preview-server.mjs 18082 18080"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "esbuild": "^0.24.2",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
